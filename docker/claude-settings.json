{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read", "Edit", "Write", "Glob", "Grep", "WebFetch", "WebSearch",
      "Bash(ls:*)", "Bash(cat:*)", "Bash(cd:*)", "Bash(pwd)", "Bash(echo:*)",
      "Bash(grep:*)", "Bash(find:*)", "Bash(git:*)", "Bash(python:*)",
      "Bash(python3:*)", "Bash(pip:*)", "Bash(uv:*)", "Bash(conda:*)",
      "Bash(make:*)", "Bash(bash:*)", "Bash(mkdir:*)", "Bash(cp:*)",
      "Bash(mv:*)", "Bash(touch:*)", "Bash(chmod:*)", "Bash(ln:*)",
      "Bash(tar:*)", "Bash(unzip:*)", "Bash(wget:*)", "Bash(curl:*)",
      "Bash(nvidia-smi:*)"
    ],
    "ask": [
      "Bash(rm:*)", "Bash(rmdir:*)", "Bash(sudo:*)", "Bash(git clean:*)",
      "Bash(git reset --hard:*)", "Bash(dd:*)", "Bash(mkfs:*)",
      "Bash(shred:*)", "Bash(truncate:*)", "Bash(docker:*)"
    ]
  }
