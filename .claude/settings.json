{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Bash(rm:*)",
      "Bash(sudo:*)",
      "Bash(chmod -R:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/credentials*)",
      "Read(~/.ssh/**)"
    ]
  }
}